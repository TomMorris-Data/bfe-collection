# ── Cloudflare Worker secrets ─────────────────────────────────────────────────
# Set these via:  npx wrangler secret put SECRET_NAME  (in the worker/ directory)
# They are NOT stored in .env — Cloudflare manages secrets separately.

# Supabase — find in dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── SharePoint sync (Azure AD app registration) ───────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FILE_PATH=/General/farms.csv

# ── Frontend (set in Cloudflare Pages dashboard or .env.local) ────────────────
# Local dev — worker runs on :8787 by default via wrangler dev
NEXT_PUBLIC_API_URL=http://localhost:8787
# Production — set to your deployed worker URL in Pages environment variables:
# NEXT_PUBLIC_API_URL=https://bfe-health-api.your-subdomain.workers.dev
